# --- Runtime ---
NODE_ENV=development
PORT=4101
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (Session 2) ---
# Leave commented in dev/local to skip the DB (the server still boots
# and /health/ready will report postgres: 'unreachable'). In CI / docker-
# compose, uncomment and supply a real Postgres URI.
# VAULT_DB_URI=postgres://vault:vault@localhost:5432/aadhaar_vault

# --- Key provider (Session 3) ---
# The factory defaults to `local-dev` when KEY_PROVIDER is unset, so the
# line below only needs to appear when overriding to a real KMS adapter.
KEY_PROVIDER=local-dev
# Master key supplied as base64 (32+ bytes recommended). The default below
# is a deterministic dev sentinel — DO NOT use in production. Treat any
# value here as having zero confidentiality: anyone who can read this
# file can derive every DEK this process has ever wrapped.
LOCAL_DEV_MASTER_KEY=Y29tLnZpY2hhcmFuYXNoYWxhLmRldi5hYWRoYWFyLXZhdWx0LWRldi1rZXktdjEtbm90LWZvci1wcm9k
KEY_VERSION=kv-1

# --- Service JWT (Session 4) ---
# Shared HS256 secret used by the vault to verify bearer tokens issued
# by the FLN backend. MUST be set in any non-test deployment; missing in
# NODE_ENV=production will abort boot.
#
# Generate one with: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
# and distribute the same value to the FLN backend (it must use the same
# secret to mint tokens). Rotate quarterly.
SERVICE_JWT_HMAC_SECRET=replace-me-with-a-real-32-byte-secret

# Required audience (the vault rejects tokens minted for any other aud).
SERVICE_JWT_AUDIENCE=fln-vault
# Required issuer — the vault rejects tokens whose `iss` does not match.
SERVICE_JWT_ISSUER=https://fln-backend.example.invalid
# Algorithm selector. Only HS256 is wired today; RS256/JWKS lands later.
# SERVICE_JWT_ALGORITHM=HS256
# Allowed clock skew in seconds for exp/nbf. Defaults to 30s when unset.
# SERVICE_JWT_CLOCK_TOLERANCE_SECONDS=30

# --- Safety guard (per AADHAAR_VAULT_FREE_ARCHITECTURE.md §5.1) ---
# When NODE_ENV=production, the Vault refuses to start with KEY_PROVIDER=local-dev
# unless this is explicitly set to true. Required to avoid silent key leaks.
# VAULT_ALLOW_UNSAFE_KEY_PROVIDER=false