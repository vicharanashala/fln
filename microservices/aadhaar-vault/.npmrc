# Session-1 local install config.
# Forces npm to install dependencies inside this microservice's own
# node_modules instead of hoisting to the repository root, which is
# already a workspaces monorepo (@fln/backend, @fln/frontend, ...).
#
# See AADHAAR_VAULT_FREE_ARCHITECTURE.md §6 (bootstrap invariant).
install-strategy=nested
legacy-peer-deps=true
save-exact=false
fund=false
audit=false