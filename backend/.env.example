PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fln_platform?retryWrites=true&w=majority


JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# LLM used for AI diagnostic/worksheet grading (backend/src/gemini.ts): Groq is
# tried first (cheaper/more generous free tier), Gemini is the fallback if
# GROQ_API_KEY is unset or the call fails. Both are already documented in the
# root .env.example (used by ai-services/) — this repeats them here since
# index.ts loads the root .env directly and this file is otherwise easy to
# miss when setting up the backend specifically.
GROQ_API_KEY=
GEMINI_API_KEY=

# Shared password for the seeded demo accounts (stored only as a bcrypt hash).
# Defaults to the public demo password if unset; set a private value for real deployments.
SEED_DEMO_PASSWORD=Fln@2026

# PDF generation uses headless Chrome via Puppeteer. Install the browser once with:
#   npx puppeteer browsers install chrome
# (plus its system libraries on Linux). Leave CHROME_EXECUTABLE_PATH unset to use
# that managed browser, or point it at a specific Chrome/Chromium binary.
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
