PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fln_platform?retryWrites=true&w=majority


JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Shared password for the seeded demo accounts (stored only as a bcrypt hash).
# Defaults to the public demo password if unset; set a private value for real deployments.
SEED_DEMO_PASSWORD=Fln@2026

# Misconception archetypes: name them from the cluster centroid instead of
# calling a model. Set to `off` to make the feature entirely network-free.
# Which children group together is decided by distance either way — this only
# changes the wording, so turning it off costs no accuracy and makes the names
# reproducible (the same cohort always yields the same labels).
MISCONCEPTION_AI_NAMING=off

# PDF generation uses headless Chrome via Puppeteer. Install the browser once with:
#   npx puppeteer browsers install chrome
# (plus its system libraries on Linux). Leave CHROME_EXECUTABLE_PATH unset to use
# that managed browser, or point it at a specific Chrome/Chromium binary.
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Aadhaar vault (required for student registration and bulk import).
# LOCAL_DEV_MASTER_KEY: base64-encoded key with the required decoded length (>= 32 bytes).
# Generate a key with: openssl rand -base64 32
LOCAL_DEV_MASTER_KEY=

# In production (NODE_ENV=production), LocalDevKeyManager requires setting
# VAULT_ALLOW_UNSAFE_KEY_PROVIDER=true to acknowledge that the master key lives in
# process environment variables. Enabling this flag acknowledges the risk but does NOT
# make the local provider production-safe; deployment owners must review security implications.
# VAULT_ALLOW_UNSAFE_KEY_PROVIDER=true

# Note: MONGODB_URI (configured above) must point to a MongoDB replica set
# because vault multi-document transactions require replica set support.
